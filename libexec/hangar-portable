#!/usr/bin/env python3
"""Decrypted data ISO, bootable disk export, and an independent access kit.

Does not run a VM, modify host bootloaders, or import archives.
"""
import json
import os
import re
import runpy
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

CONF = "/etc/hangar"
RUNNER = "/usr/libexec/hangar/hangar-run"
CACHE = "/var/cache/hangar/restic"
VHD_EXEC = Path("/usr/libexec/hangar/hangar-vhd")
VHD_BUNDLED = Path("/usr/share/cockpit/hangar/libexec/hangar-vhd")
SNAPSHOT_RE = re.compile(r"[0-9a-fA-F]{64}\Z")
REPO_RE = re.compile(r"[a-z0-9](?:[a-z0-9-]{0,62})\Z")


def abort(message):
    raise ValueError(message)


def valid_path(value, suffixes=()):
    path = Path(value)
    if not path.is_absolute() or "\0" in value or "\n" in value:
        abort("Specify an absolute path on the Cockpit host.")
    if suffixes and path.suffix.lower() not in suffixes:
        abort("Expected a " + " or ".join(suffixes) + " file.")
    return path


def repository(repo_id):
    if not REPO_RE.fullmatch(repo_id):
        abort("Invalid repository ID.")
    with open(Path(CONF) / "repos" / (repo_id + ".json"), encoding="utf-8") as fh:
        definition = json.load(fh)
    if not isinstance(definition, dict):
        abort("Invalid repository definition.")
    key = Path(CONF) / "repos" / (repo_id + ".key")
    if not key.is_file():
        abort("Repository password is missing. Enter it again in Repositories first.")
    # Reuse exactly the existing runner's backend URL and credential handling.
    runner = runpy.run_path(RUNNER, run_name="hangar_portable")
    url = runner["repo_url"](definition)
    env = dict(os.environ, **runner["backend_env"](definition))
    args = ["restic", "-r", url, "--password-file", str(key),
            "--cache-dir", CACHE]
    return definition, args, env


def export_iso(repo_id, snapshot, filename):
    if not SNAPSHOT_RE.fullmatch(snapshot):
        abort("Select a full snapshot ID.")
    output = valid_path(filename, (".iso",))
    if output.exists():
        abort("The destination ISO already exists; choose a new name.")
    if not output.parent.is_dir():
        abort("The destination directory does not exist.")
    if not shutil.which("xorriso"):
        abort("xorriso is required to create an ISO image.")
    _, args, env = repository(repo_id)
    # Stage near the destination rather than filling /tmp when the snapshot is large.
    with tempfile.TemporaryDirectory(prefix=".hangar-iso-", dir=output.parent) as work:
        source = Path(work) / "contents"
        source.mkdir()
        staging_iso = Path(work) / "image.iso"
        print("Decrypting snapshot into temporary files...", flush=True)
        subprocess.run(args + ["restore", "--target", str(source), snapshot],
                       env=env, check=True, stdout=subprocess.DEVNULL)
        print("Creating data ISO (not bootable)...", flush=True)
        subprocess.run(["xorriso", "-as", "mkisofs", "-iso-level", "3",
                        "-R", "-J", "-o", str(staging_iso), str(source)],
                       check=True, stdout=subprocess.DEVNULL)
        if output.exists():
            abort("The destination was created while the ISO was being built.")
        os.replace(staging_iso, output)
    print("ISO created: " + str(output), flush=True)


# Old access kits used this restic-only wrapper. Recognize it exactly to avoid
# overwriting a user's custom script while still supporting already-made kits.
LEGACY_ACCESS_SCRIPT = """#!/bin/sh
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec restic -r "$here" --password-file "$here/hangar-access.key" "$@"
"""

ACCESS_SCRIPT_V2 = r"""#!/bin/sh
# Hangar standalone access kit v2 — requires restic; ISO also needs xorriso.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
key="$here/hangar-access.key"
if [ "$#" -gt 0 ] && [ "$1" = "iso" ]; then
    shift
    if [ "$#" -ne 2 ]; then
        echo "Usage: $0 iso <latest|snapshot-id> </absolute/output.iso>" >&2
        exit 2
    fi
    snapshot=$1
    output=$2
    case "$snapshot" in ""|-*) echo "Invalid snapshot ID" >&2; exit 2;; esac
    case "$output" in /*.iso) ;; *) echo "Use an absolute .iso output path" >&2; exit 2;; esac
    if [ -e "$output" ] || [ -L "$output" ]; then
        echo "Refusing to overwrite: $output" >&2
        exit 1
    fi
    output_dir=$(dirname -- "$output")
    if [ ! -d "$output_dir" ]; then
        echo "Output directory does not exist: $output_dir" >&2
        exit 1
    fi
    command -v restic >/dev/null 2>&1 || { echo "restic not installed" >&2; exit 1; }
    command -v xorriso >/dev/null 2>&1 || { echo "xorriso not installed" >&2; exit 1; }
    work=$(mktemp -d "$output_dir/.hangar-iso.XXXXXXXX")
    trap 'rm -rf -- "$work"' 0
    trap 'exit 130' 1 2 3 15
    mkdir "$work/files"
    echo "Decrypting snapshot $snapshot..."
    restic -r "$here" --password-file "$key" restore "$snapshot" --target "$work/files"
    echo "Creating a non-bootable, unencrypted data ISO..."
    xorriso -as mkisofs -iso-level 3 -R -J -o "$work/data.iso" "$work/files"
    if [ -e "$output" ] || [ -L "$output" ]; then
        echo "Refusing to overwrite: $output" >&2
        exit 1
    fi
    # The temporary image sits on the destination filesystem. Avoid
    # overwriting existing files (and work on filesystems without hard links).
    mv -n -- "$work/data.iso" "$output"
    if [ -e "$work/data.iso" ]; then
        echo "Refusing to overwrite: $output" >&2
        exit 1
    fi
    echo "ISO created: $output"
    exit 0
fi
exec restic -r "$here" --password-file "$key" "$@"
"""

# Preserve an exact copy of the shipped v2 script to safely upgrade access
# kits without touching third-party or user-modified scripts.
ACCESS_SCRIPT = ACCESS_SCRIPT_V2.replace(
    "Hangar standalone access kit v2", "Hangar standalone access kit v3"
).replace(
    'exec restic -r "$here" --password-file "$key" "$@"',
    '''if [ "$#" -gt 0 ] && { [ "$1" = "raw" ] || [ "$1" = "img" ] || [ "$1" = "vhd" ] || [ "$1" = "vhdx" ]; }; then
    shift
    if [ "$#" -ne 2 ]; then
        echo "Usage: $0 raw <latest|snapshot-id> </absolute/output.raw> (also: img, vhdx, vhd)" >&2
        exit 2
    fi
    exec python3 "$here/hangar-vhd.py" --repo "$here" --password-file "$key" --snapshot "$1" --output "$2"
fi
exec restic -r "$here" --password-file "$key" "$@"'''
)

# Only copies of Hangar's generated helper may be refreshed automatically.
BUILDER_HEADER = '#!/usr/bin/env python3\n"""Create an offline, UEFI-bootable VHDX/VHD'


def publish_builder(source, dest):
    new = source.read_bytes()
    if dest.exists():
        current = dest.read_bytes()
        if current == new:
            return
        if not current.startswith(BUILDER_HEADER.encode("utf-8")):
            abort("Existing hangar-vhd.py is not recognized. Refusing to overwrite.")
    temp = None
    try:
        with tempfile.NamedTemporaryFile(dir=dest.parent,
                                         prefix=".hangar-vhd-", delete=False) as fh:
            temp = Path(fh.name)
            fh.write(new)
        temp.chmod(0o700)
        os.replace(temp, dest)
    finally:
        if temp:
            temp.unlink(missing_ok=True)



def vhd_builder():
    # When an older self-updater first discovers a newer Hangar release it
    # copies the plugin bundle, but might omit newly added /usr/libexec helpers.
    # The bundled helper was downloaded in that same update; using it directly
    # lets disk export work immediately without a manual install.
    for path in (VHD_EXEC, VHD_BUNDLED):
        if path.is_file() and not path.is_symlink():
            return path
    abort("The VHDX builder is missing from both installed Hangar paths. "
          "Run Hangar Settings → Install update or reinstall Hangar.")


def export_access_kit(repo_id):
    definition, _, _ = repository(repo_id)
    if definition.get("kind") != "local":
        abort("Access kits alongside the backup are available for local repositories only.")
    folder = valid_path(str(definition.get("path", "")))
    if not folder.is_dir() or not (folder / "config").is_file():
        abort("Local restic repository directory does not exist.")
    key_file = Path(CONF) / "repos" / (repo_id + ".key")
    key_dest = folder / "hangar-access.key"
    script_dest = folder / "hangar-access.sh"
    builder_source = vhd_builder()
    builder_dest = folder / "hangar-vhd.py"
    if not builder_source.is_file():
        abort("Bootable disk image helper is not installed. Update Hangar first.")
    if builder_dest.is_symlink():
        abort("Refusing to replace symlinked access-kit builder.")
    key_bytes = key_file.read_bytes()

    # A password from another repository is NEVER silently replaced.
    if key_dest.exists() and key_dest.read_bytes() != key_bytes:
        abort("Existing access-kit key does not match Hangar's password. Not overwriting.")
    if script_dest.exists():
        saved = script_dest.read_text(encoding="utf-8")
        if saved not in (ACCESS_SCRIPT, ACCESS_SCRIPT_V2, LEGACY_ACCESS_SCRIPT):
            abort("An unrecognized access script already exists. Not overwriting it.")
    else:
        saved = None

    created_key = False
    if not key_dest.exists():
        fd = os.open(key_dest, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        created_key = True
        with os.fdopen(fd, "wb") as fh:
            fh.write(key_bytes)

    # Install independent builder before exposing an access script that uses it.
    publish_builder(builder_source, builder_dest)

    if saved != ACCESS_SCRIPT:
        try:
            with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8",
                    dir=folder, prefix=".hangar-access-", delete=False) as fh:
                temp = Path(fh.name)
                fh.write(ACCESS_SCRIPT)
            temp.chmod(0o700)
            os.replace(temp, script_dest)
        except BaseException:
            if "temp" in locals():
                temp.unlink(missing_ok=True)
            if created_key:
                key_dest.unlink(missing_ok=True)
            raise

    print("Standalone access kit ready in " + str(folder), flush=True)
    print("Run: ./hangar-access.sh iso latest /absolute/path/backup.iso", flush=True)
    print("Bootable disk: ./hangar-access.sh raw latest /absolute/path/backup.raw", flush=True)
    print("WARNING: Anyone with this directory can decrypt the backups.", flush=True)


def main(argv):
    if os.geteuid() != 0:
        abort("Administrator access is required.")
    if len(argv) == 5 and argv[1] == "iso":
        export_iso(argv[2], argv[3], argv[4])
    elif len(argv) in (5, 7) and argv[1] in ("raw", "img", "vhdx", "vhd"):
        _, args, env = repository(argv[2])
        program = [
            sys.executable, str(vhd_builder()),
            "--repo", args[2],
            "--password-file", args[4],
            "--cache-dir", CACHE,
            "--snapshot", argv[3],
            "--output", argv[4]
        ]
        if len(argv) == 7:
            program += ["--progress-file", argv[5], "--job-id", argv[6]]
        # Preserve the service's main PID: cancellation signals must reach the
        # builder itself, not an idle wrapper waiting on a subprocess.
        os.execvpe(sys.executable, program, env)
    elif len(argv) == 3 and argv[1] == "access-kit":
        export_access_kit(argv[2])
    else:
        abort("Usage: hangar-portable iso|raw|img|vhdx|vhd REPO SNAPSHOT OUTPUT | access-kit REPO")


if __name__ == "__main__":
    try:
        main(sys.argv)
    except (ValueError, OSError, subprocess.CalledProcessError) as exc:
        print("Hangar: " + str(exc), file=sys.stderr)
        sys.exit(1)
